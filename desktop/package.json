{
  "name": "mapip-desktop",
  "version": "0.1.0",
  "description": "MapIp Desktop — network host mapper (NOT geolocation)",
  "main": "dist/main.js",
  "author": "5evenTeam",
  "scripts": {
    "dev": "tsc --project tsconfig.main.json && vite build && electron .",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build:main && electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.fiveteam.mapip",
    "productName": "MapIp",
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mapip.exe",
        "to": "mapip.exe"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MapIp"
    },
    "win": {
      "target": "nsis"
    }
  }
}
